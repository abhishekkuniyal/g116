# Option A (recommended on Windows): connection parts
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=g116
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=yes
DB_TRUSTED_CONNECTION=yes
DB_USERNAME=
DB_PASSWORD=

# Option B: if set, this full URL overrides the fields above.
