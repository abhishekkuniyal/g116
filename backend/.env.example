APP_NAME=G116 Fertilizer Forecast API
API_V1_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# SQL Server configuration
# -----------------------------------------------------------------------------
# Recommended driver. Use exactly a driver name printed by:
#   uv run python -c "import pyodbc; print(pyodbc.drivers())"
DB_DRIVER=ODBC Driver 18 for SQL Server

# Choose the SQL Server instance that actually exists on your machine.
# LocalDB example:
DB_SERVER=(localdb)\MSSQLLocalDB
# SQL Server Express example:
# DB_SERVER=localhost\SQLEXPRESS
# Default/local SQL Server example:
# DB_SERVER=localhost
# Remote example:
# DB_SERVER=server-name-or-ip,1433

DB_NAME=g116
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes

# Windows Authentication (recommended for local development):
DB_TRUSTED_CONNECTION=yes
DB_USERNAME=
DB_PASSWORD=

# SQL Server Authentication example:
# DB_TRUSTED_CONNECTION=no
# DB_USERNAME=your_user
# DB_PASSWORD=your_password

# Optional full SQLAlchemy URL. If set, this overrides DB_SERVER/DB_* fields.
DATABASE_URL=

# -----------------------------------------------------------------------------
# Processed data locations
# -----------------------------------------------------------------------------
# Blank DATA_DIR means: <repo-root>/data/processed
DATA_DIR=

# Optional external directory for the two IFFCO files. This solves the case where
# they currently live at D:/IFFCO_Data_Preprocessing/processed.
# Git Bash/Windows example:
# IFFCO_DATA_DIR=D:/IFFCO_Data_Preprocessing/processed
IFFCO_DATA_DIR=

# Exact project completeness checks.
STRICT_IMPORT_COUNTS=true
EXPECTED_FORECAST_ROWS=144
EXPECTED_HISTORY_ROWS=1440
EXPECTED_IFFCO_ROWS=44
EXPECTED_RAJASTHAN_ROWS=132

# React/Vite development origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
